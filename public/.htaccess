# Block direct access to SMTP configuration files.
<FilesMatch "send-mail\.config(\.example)?\.php$">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # V21: cache immutable Vite assets and media aggressively. Hashed /assets
    # filenames are safe for a one-year immutable lifetime; public images/fonts
    # use a shorter lifetime so future replacements propagate normally.
    <FilesMatch "\.(?:js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:avif|webp|png|jpe?g|gif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# V21: explicit browser expiration policy for HostGator/Apache.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Resolve legacy URLs directly to the canonical HTTPS/non-www destination.
    RewriteRule ^kustannuslaskuri/?$ https://maalausmultivari.fi/maalauslaskuri [L,R=301,NE]
    RewriteRule ^paint-studio/?$ https://maalausmultivari.fi/varikamu [L,R=301,NE]
    RewriteRule ^siivoussuunnittelija/?$ https://maalausmultivari.fi/varikamu [L,R=301,NE]
    RewriteRule ^cleaning-studio/?$ https://maalausmultivari.fi/varikamu [L,R=301,NE]
    RewriteRule ^siivouskamu/?$ https://maalausmultivari.fi/varikamu [L,R=301,NE]

    # Send common AI-tool URLs to the authenticated customer applications.
    RewriteRule ^siivouskamu/(ai|app)/?$ https://maalausmultivari.fi/app/varikamu [L,R=301,NE]
    RewriteRule ^siivouskamu-ai/?$ https://maalausmultivari.fi/app/varikamu [L,R=301,NE]
    RewriteRule ^varikamu/(ai|app)/?$ https://maalausmultivari.fi/app/varikamu [L,R=301,NE]
    RewriteRule ^varikamu-ai/?$ https://maalausmultivari.fi/app/varikamu [L,R=301,NE]

    # Keep one canonical URL format: root keeps '/', other pages do not.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ https://maalausmultivari.fi/$1 [L,R=301,NE]

    # One-hop canonical host: HTTPS + non-www.
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^maalausmultivari\.fi$ [NC]
    RewriteRule ^ https://maalausmultivari.fi%{REQUEST_URI} [L,R=301]

    # Serve build-time SEO entry documents for the 15 highest-priority
    # painting service + city pages while preserving the public clean URL.
    # React still hydrates normally after the static metadata is read.
    RewriteRule ^palvelut/(talon-maalaus|ulkomaalaus|sisamaalaus|julkisivumaalaus|kattomaalaus)/(helsinki|espoo|vantaa)$ /_seo/palvelut/$1/$2.html [L]

    # SPA fallback: real files/directories bypass React Router.
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
