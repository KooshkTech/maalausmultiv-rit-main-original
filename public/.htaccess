# Block direct access to SMTP configuration files.
<FilesMatch "send-mail\.config(\.example)?\.php$">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # One-hop canonical host: HTTPS + non-www.
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^maalausmultivari\.fi$ [NC]
    RewriteRule ^ https://maalausmultivari.fi%{REQUEST_URI} [L,R=301]

    # V20 permanent URL migration. Keep old indexed planner URLs out of the sitemap.
    RewriteRule ^kustannuslaskuri/?$ /maalauslaskuri [L,R=301,NE]
    RewriteRule ^paint-studio/?$ /varikamu [L,R=301,NE]
    RewriteRule ^siivoussuunnittelija/?$ /varikamu [L,R=301,NE]
    RewriteRule ^cleaning-studio/?$ /varikamu [L,R=301,NE]
    RewriteRule ^siivouskamu/?$ /varikamu [L,R=301,NE]

    # Send common AI-tool URLs to the authenticated customer applications.
    RewriteRule ^siivouskamu/(ai|app)/?$ /app/varikamu [L,R=301,NE]
    RewriteRule ^siivouskamu-ai/?$ /app/varikamu [L,R=301,NE]
    RewriteRule ^varikamu/(ai|app)/?$ /app/varikamu [L,R=301,NE]
    RewriteRule ^varikamu-ai/?$ /app/varikamu [L,R=301,NE]

    # Keep one canonical URL format: root keeps '/', other pages do not.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301,NE]

    # SPA fallback: real files/directories bypass React Router.
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
