# Block direct access to the SMTP config file (credentials live there).
<FilesMatch "send-mail\.config\.php$">
    Require all denied
</FilesMatch>

# Block access to the example config too — keeps the public surface clean.
<FilesMatch "send-mail\.config\.example\.php$">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# SPA fallback: let React Router handle all routes that aren't real files.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS.
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Force non-www (canonical host used throughout the site's metadata).
    RewriteCond %{HTTP_HOST} ^www\.maalausmultivari\.fi$ [NC]
    RewriteRule ^(.*)$ https://maalausmultivari.fi/$1 [L,R=301]

    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
